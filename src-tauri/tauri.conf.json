{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DisplayPilot",
  "version": "0.1.0",
  "identifier": "app.displaypilot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "DisplayPilot",
        "url": "index.html",
        "width": 360,
        "height": 620,
        "minWidth": 320,
        "minHeight": 250,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "focus": true,
        "shadow": true
      },
      {
        "label": "settings",
        "title": "DisplayPilot 设置",
        "url": "settings.html",
        "width": 520,
        "height": 640,
        "minWidth": 460,
        "minHeight": 520,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "DDC/CI display input and brightness control",
    "longDescription": "DisplayPilot switches monitor inputs, brightness, volume and mute over DDC/CI from the menu bar or system tray.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
